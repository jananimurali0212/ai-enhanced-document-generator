# ==============================================================================
# AI-Enhanced Document Generator - Backend Environment Configuration
# ==============================================================================

# Google Gemini API Key (Strictly server-side; NEVER expose to frontend)
# Obtain a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g., gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Generation Parameters
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=4096
AI_REQUEST_TIMEOUT=60

# ==============================================================================
# Supabase Configuration (Day 3: Persistence & Authentication)
# Obtain from: https://app.supabase.com/project/_/settings/api
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Local Development & Fallback Flags
ALLOW_MOCK_FALLBACK=true
ALLOW_DEMO_AUTH=true
